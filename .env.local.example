# Supabase
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase (admin API routes + setup scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# ── GR field extraction chain ────────────────────────────────────────────────
# Each layer is tried in order until one returns structured records, so any one
# provider being down or weak on a page won't break scanning. Configure as many
# as you can; at least one of Gemini / Mistral is strongly recommended.

# 1) PRIMARY — Gemini vision (reads any register layout, great on handwritten Gujarati)
#    Free key from https://aistudio.google.com/apikey  (no billing account required)
GEMINI_API_KEY=your-gemini-api-key
# Optional override (default: gemini-2.5-pro for handwriting accuracy).
# GEMINI_MODEL=gemini-2.5-pro

# 2) SECONDARY — Mistral vision (independent VLM; used if Gemini finds nothing)
#    Key from https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key
# Optional override (default: mistral-small-latest; try mistral-medium-latest for tough handwriting)
# MISTRAL_MODEL=mistral-small-latest

# 2b) OPENAI — GPT-5 vision (frontier VLM; top handwriting accuracy on current benchmarks)
#    Key from https://platform.openai.com/api-keys  (paid — usage-billed)
OPENAI_API_KEY=your-openai-api-key
# Optional override (default: gpt-5.6; gpt-5.6-terra is cheaper, gpt-5.6-luna is high-volume)
# OPENAI_MODEL=gpt-5.6

# 3) SARVAM — one key, three roles (get it from https://dashboard.sarvam.ai/):
#    a) Document AI (Vision 1.5) is now the PRIMARY raw-OCR ANCHOR — it transcribes each
#       page (Indic-specialised, strong on handwritten Gujarati) that the whole chain is
#       grounded against. OCR.space below is only its fallback.
#    b) Document AI also runs FIRST as a direct schema-based extractor (sarvam-doc-ai-extract).
#    c) The chat-completions model (sarvam-30b) still runs LAST as a text-only structurer.
#    All three use this same key (sent as the api-subscription-key header).
SARVAM_API_KEY=your-sarvam-api-key
# Optional: chat-completions structurer model (default: sarvam-30b; sarvam-105b for the largest context)
# SARVAM_MODEL=sarvam-30b
# Optional: Document AI digitise content-type hint. GR pages are handwritten forms; the
# Sarvam dashboard exposes printed | handwritten | mixed. Defaults to "handwritten". If
# the API rejects the value it auto-falls-back to Sarvam's default, so leave unset if unsure.
# SARVAM_DOC_AI_CONTENT_TYPE=handwritten
# Optional: Document AI model override (default: sarvam-vision-v1)
# SARVAM_DOC_AI_MODEL=sarvam-vision-v1

# 4) RAW OCR FALLBACK — OCR.space. Used only when Sarvam Document AI (3a) is unset, fails,
#    or times out on a page; also feeds the client's heuristic parser.
#    Free key from https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your-ocr-space-key

# ── Extraction tuning (all optional) ─────────────────────────────────────────
# Mobile-photo preprocessing (auto-orient + grayscale + contrast + upscale) applied
# before every reader. On by default; set to "off" to send the raw photo (A/B testing).
# OCR_PREPROCESS=on
#
# Production chain order — comma-separated; the first reader that returns records wins.
# Flip this to put the winner from the compare tool first (e.g. lead with GPT-5):
#   OCR_EXTRACTOR_ORDER=openai,sarvam-doc-ai,gemini,gemini-text,mistral,sarvam-text
# Valid keys: sarvam-doc-ai | gemini | gemini-text | openai | mistral | sarvam-text
# OCR_EXTRACTOR_ORDER=gemini,sarvam-doc-ai,gemini-text,openai,mistral,sarvam-text
#
# Enable the "compare all engines" diagnostic — POST /api/ocr-test?debug=all and the
# /dashboard/records/compare page. Leave UNSET in production.
# OCR_DEBUG_COMPARE=1
# Which models the compare tool runs (comma-separated):
# OCR_COMPARE_GEMINI_MODELS=gemini-2.5-pro,gemini-3.1-pro-preview
# OCR_COMPARE_OPENAI_MODELS=gpt-5.6

# ── English voice input: grouped single + multi-student (all optional) ─────────
# Voice extraction runs only on the server and reuses GEMINI_API_KEY above; no
# browser credential or additional provider account is needed. One response returns
# the audit transcript plus English and Gujarati values for each field. Single mode
# returns one bilingual group; multi mode returns ordered bilingual student records.
# Expected count is advisory and never pads or truncates results. Script toggles are
# local and never trigger a second provider request.
# Optional audio-model override (default: gemini-3.7-flash):
# GEMINI_AUDIO_MODEL=gemini-3.7-flash
# Production extractor order. The only registered v1 key is gemini-audio.
# VOICE_EXTRACTOR_ORDER=gemini-audio
# v1 supports Indian English only; leave this at en-IN.
# VOICE_LANGUAGE=en-IN
# Maximum accepted expected-count hint and review batch size (clamped to 1–10;
# default 10). Prefer 6 or fewer entries per recording for stronger segmentation.
VOICE_MAX_ENTRIES=10
# Enable POST /api/voice-entry?debug=all and /dashboard/records/voice-compare.
# Leave UNSET/OFF in production because every compared model consumes paid quota.
# VOICE_DEBUG_COMPARE=1
# Models run in parallel by the voice comparison tool (comma-separated). Each
# model returns grouped fields or ordered students according to the request mode.
# If unset, it compares GEMINI_AUDIO_MODEL/default with gemini-2.5-flash.
# VOICE_COMPARE_GEMINI_MODELS=gemini-3.7-flash,gemini-2.5-flash
